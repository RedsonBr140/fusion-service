# Template pra .env.development (gitignorado) — usado só por
# docker-compose.dev.yml, nunca pelo app.py/config.py diretamente (esses
# continuam lendo .env). Copie pra .env.development e preencha o que for
# testar:
#
#   cp .env.development.example .env.development
#
# Em branco = seguro por padrão (ciss_client/fusion_client ficam None,
# o ciclo nunca sai do guard "ciss_nao_configurado" em
# cargas_fusion/auto_envio.py — só prova o lock/scheduler, sem tocar
# rede nenhuma). REDIS_URL nunca entra aqui: fica fixo no
# docker-compose.dev.yml apontando pro redis do próprio compose, de
# propósito — não existe um jeito "errado" de preenchê-lo aqui.

SECRET_KEY=chave-de-teste-local-sem-valor-real
CISS_API_URL=http://ciss-api.invalido.local

# --- CISS DB2 (opcional) ---------------------------------------------
# Todas ou nenhuma. Preencher com credenciais reais também exige o
# clidriver da IBM montado no container (proprietário, não entra na
# imagem — ver k8s/db2-driver.yaml); sem isso, mesmo com credenciais
# certas, a conexão falha por falta do driver ODBC.
CISS_DB_DRIVER=
CISS_DB_HOST=
CISS_DB_NAME=
CISS_DB_USER=
CISS_DB_PASSWORD=

# --- Fusion SOAP / portal (opcional) ----------------------------------
# Idem, todas ou nenhuma. CUIDADO: preencher isto é mandar pro Fusion de
# PRODUÇÃO de verdade — não existe um Fusion "de teste" separado.
FUSION_API_URL=
FUSION_LOGIN=
FUSION_SENHA=
FUSION_PORTAL_URL=
FUSION_PORTAL_LOGIN=
FUSION_PORTAL_SENHA=

# --- Envio automático de pré-carga solta ------------------------------
AUTO_ENVIO_PRE_CARGA_ATIVO=true
AUTO_ENVIO_PRE_CARGA_INTERVALO_SEGUNDOS=15
AUTO_ENVIO_PRE_CARGA_JANELA_HORAS=24
# Default de produção é 2026-10-28T08:00:00 — antes disso, o ciclo nunca
# processa nada (guard "antes_do_corte"), de propósito. Pra um teste
# live que precise ver pré-carga de verdade sendo processada hoje, mude
# isto pra uma data no passado (ex. 2020-01-01T00:00:00). Deixe vazio
# pra manter o default de produção.
AUTO_ENVIO_PRE_CARGA_CORTE=

DISCORD_WEBHOOK_URL=

# Segredo deste serviço — assina os tokens de sessão (auth/tokens.py).
SECRET_KEY=

# CISS — autenticação (login: allow-list local antes do CISS)
CISS_API_URL=
CISS_CA_BUNDLE=

# CISS DB2 — leitura (ODBC). Todas obrigatórias, ou nenhuma.
CISS_DB_DRIVER=
CISS_DB_HOST=
CISS_DB_NAME=
CISS_DB_USER=
CISS_DB_PASSWORD=
CISS_DB_PORT=50000
CISS_DB_TIMEOUT=10

# Fusion — webservice SOAP (saveCarga e companhia). Todas ou nenhuma.
FUSION_API_URL=
FUSION_LOGIN=
FUSION_SENHA=
# Id interno do Fusion pra esta empresa (não o CNPJ) — usado no
# heartbeat set_dt_ult_int_erp.php (ver integrations/fusion.py).
FUSION_EMPRESA_ID=

# Fusion — portal web (fusion-py), login humano. Todas ou nenhuma.
FUSION_PORTAL_URL=
FUSION_PORTAL_LOGIN=
FUSION_PORTAL_SENHA=

# Caminho do SQLite deste serviço.
DATABASE_PATH=fusion_service.db

PORT=5050

# Liga a carga real (CISS) na API/frontend — rotas /cargas* e aba
# "Histórico" ficam bloqueadas enquanto for false. Formação de carga
# passou a acontecer dentro do próprio Fusion; pré-carga não é afetada.
MOSTRAR_CARGAS_CISS=false

# Bloqueia o envio empacotado num saveCarga (carga real e pré-carga no
# modo padrão) — só /pre-cargas/.../enviar-solta fica disponível
# enquanto for true. Independente de MOSTRAR_CARGAS_CISS.
SOMENTE_PEDIDOS_SOLTOS=true

# Ciclo automático de envio de pré-carga solta (cargas_fusion/auto_envio.py).
# Desligado por padrão. Ligar exige REDIS_URL (lock contra os 2 workers
# do gunicorn rodarem o ciclo em dobro).
AUTO_ENVIO_PRE_CARGA_ATIVO=false
REDIS_URL=
AUTO_ENVIO_PRE_CARGA_INTERVALO_SEGUNDOS=300
AUTO_ENVIO_PRE_CARGA_JANELA_HORAS=24
# Pré-carga com DTMOVIMENTO anterior a isto nunca é tocada pelo ciclo
# automático. Vazio = default de produção (2026-10-28T08:00:00) — só
# mude isto pra um teste local/live deliberado contra pré-carga mais
# antiga, nunca em produção.
AUTO_ENVIO_PRE_CARGA_CORTE=

# Webhook do Discord pra alertar falha do ciclo automático e pré-carga
# multi-pedido ignorada. Opcional — sem ele, só loga.
DISCORD_WEBHOOK_URL=

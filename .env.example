# Só infraestrutura do pod. Todo o resto (CISS, Fusion, Discord, flags,
# intervalos) mora na tabela `configuracoes` do sqlite e se edita na aba
# Administração. Ver README.md, "Configuração: no banco, não no .env".
#
# Primeira subida: sem admin, o backend grava um token de uso único em
# setup-token.txt ao lado do banco. Abra a app e conclua o setup inicial.

# Caminho do SQLite deste serviço.
DATABASE_PATH=fusion_service.db

PORT=5050
LOG_LEVEL=INFO

# Lock do ciclo automático de envio e do rastreio contra os 2 workers do
# gunicorn. Sem ele, os dois não podem ser ligados na tela.
REDIS_URL=

# Migração: qualquer antiga variável (CISS_API_URL, FUSION_SENHA,
# SECRET_KEY, ...) presente aqui é copiada pro banco UMA VEZ, na primeira
# subida desta versão, e ignorada dali em diante.

# Segredo deste serviço — assina os tokens de sessão (auth/tokens.py).
SECRET_KEY=

# CISS — autenticação (login: allow-list local antes do CISS)
CISS_API_URL=
CISS_CA_BUNDLE=

# CISS DB2 — leitura (ODBC). Todas obrigatórias, ou nenhuma.
CISS_DB_DRIVER=
CISS_DB_HOST=
CISS_DB_NAME=
CISS_DB_USER=
CISS_DB_PASSWORD=
CISS_DB_PORT=50000
CISS_DB_TIMEOUT=10

# Fusion — webservice SOAP (saveCarga e companhia). Todas ou nenhuma.
FUSION_API_URL=
FUSION_LOGIN=
FUSION_SENHA=

# Fusion — portal web (fusion-py), login humano. Todas ou nenhuma.
FUSION_PORTAL_URL=
FUSION_PORTAL_LOGIN=
FUSION_PORTAL_SENHA=

# Caminho do SQLite deste serviço.
DATABASE_PATH=fusion_service.db

PORT=5050
